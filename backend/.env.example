ENVIRONMENT=development
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_PREFIX=philomatrix

# Set this only when migrating from the existing SQLite/PostgreSQL database.
# Use a rotated credential and keep the value in the ignored backend/.env file.
LEGACY_DATABASE_URL=

# Set a strong random value for deployed environments.
JWT_SECRET=replace-with-a-long-random-secret
